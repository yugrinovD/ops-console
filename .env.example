# Console authentication. Use long random values:
#   openssl rand -hex 32
CONSOLE_AUTH_TOKEN=replace-with-a-random-admin-token
# Optional read-only account. Leave empty to disable the viewer role.
CONSOLE_VIEWER_TOKEN=
# Optional explicit HMAC secret; derived from the auth token when omitted.
CONSOLE_SESSION_SECRET=

# Public origin of the console. Used for CSRF checks, cookie security and links.
CONSOLE_ORIGIN=http://localhost:3100
# Set to true when the console is served over HTTPS.
CONSOLE_COOKIE_SECURE=false
CONSOLE_DATA_DIR=./data
CONSOLE_LOG_LEVEL=info

# gogate
GOGATE_ADMIN_URL=http://127.0.0.1:9090
GOGATE_ADMIN_TOKEN=replace-with-gogate-admin-token
GOGATE_PUBLIC_URL=http://127.0.0.1:8080
# A gateway key used only by the server-side playground. It never reaches the browser.
GOGATE_PLAYGROUND_API_KEY=
GOGATE_JAEGER_URL=http://127.0.0.1:16686
# Browser-facing Jaeger URL for trace links. Falls back to GOGATE_JAEGER_URL
# when unset; in Docker set this to a URL the browser can reach.
GOGATE_JAEGER_PUBLIC_URL=http://127.0.0.1:16686
GOGATE_JAEGER_SERVICE=gogate

# Prometheus (RPS, latency, errors, tokens, cost, cache)
PROMETHEUS_URL=http://127.0.0.1:9092
PROMETHEUS_BEARER_TOKEN=
# Optional Jaeger API token (Jaeger all-in-one has no auth by default).
JAEGER_BEARER_TOKEN=

# lmlog serve
LMLOG_API_URL=http://127.0.0.1:8090
LMLOG_API_TOKEN=
LMLOG_MAX_UPLOAD_MB=50
